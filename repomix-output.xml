    // Local Prisma Postgres URL (from prisma dev output)
    url: env('DATABASE_URL'),
  },
})
```

## Workflow

1. Start local database:
   ```bash
   prisma dev
   ```

2. In another terminal, run migrations:
   ```bash
   prisma migrate dev
   ```

3. Generate client:
   ```bash
   prisma generate
   ```

4. Run your application

## Production Migration

